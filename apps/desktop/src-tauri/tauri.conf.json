{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hofund",
  "identifier": "io.logibricks.hofund",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "usage",
        "title": "Hofund",
        "url": "index.html",
        "width": 760,
        "height": 560,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
