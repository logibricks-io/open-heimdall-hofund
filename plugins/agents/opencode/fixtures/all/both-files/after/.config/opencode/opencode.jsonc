{
  // JSONC wins when both files exist.
  "model": "jsonc-model",
  "plugin": ["jsonc"],
  "provider": {
    "hofund": {
      "name": "hofund",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:3425/v1",
        "apiKey": "old-token"
      },
      "models": {
        "route-a": {
          "name": "route-a",
          "variants": {}
        },
        "route-b": {
          "name": "route-b",
          "variants": {}
        }
      }
    }
  }
}
